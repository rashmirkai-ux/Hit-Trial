rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /savedJourneys/{journeyId} {
        allow read, write: if isOwner(userId);
      }

      match /favoriteLocations/{locId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public verified safety havens (Read-only for all, write for verified admins)
    match /safeLocations/{locId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Community safety reports
    match /safetyReports/{reportId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.isGuest == true;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || request.auth.token.role == 'admin');
    }

    // Active city advisories
    match /activeAdvisories/{advisoryId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }
  }
}
